# Dockerfile for LangGraph Agents Backend
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

# Copy root package files
COPY package.json yarn.lock turbo.json ./

# Copy workspace package files
COPY apps/agents/package.json ./apps/agents/
COPY packages/shared/package.json ./packages/shared/

# Install dependencies (ignore scripts to prevent postinstall from running)
RUN yarn install --frozen-lockfile --ignore-scripts

# Build stage
FROM base AS builder
WORKDIR /app

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/agents/node_modules ./apps/agents/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules

# Copy source code
COPY turbo.json ./
COPY package.json yarn.lock ./
COPY apps/agents ./apps/agents
COPY packages/shared ./packages/shared

# Build shared package first, then agents
RUN yarn turbo build --filter=@opencanvas/shared
RUN yarn turbo build --filter=@opencanvas/agents

# Production stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Install only production dependencies
RUN apk add --no-cache libc6-compat

# Copy built artifacts and necessary files
COPY --from=builder /app/apps/agents/dist ./apps/agents/dist
COPY --from=builder /app/apps/agents/src ./apps/agents/src
COPY --from=builder /app/apps/agents/package.json ./apps/agents/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/src ./packages/shared/src
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/yarn.lock ./yarn.lock
COPY langgraph.json ./

EXPOSE 54367

# Create empty .env file to prevent LangGraph CLI error
RUN touch .env

# Start LangGraph server
CMD ["npx", "@langchain/langgraph-cli", "dev", "--port", "54367", "--host", "0.0.0.0"]
